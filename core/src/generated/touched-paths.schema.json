{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "paths": {
      "items": {
        "pattern": "^(?!\\.\\.?(?:\\/|$))[A-Za-z0-9._-]+(?:\\/(?!\\.\\.?(?:\\/|$))[A-Za-z0-9._-]+)*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "v": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "v",
    "paths"
  ],
  "type": "object"
}
