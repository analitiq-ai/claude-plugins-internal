{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "feature",
        "defect",
        "no_spec"
      ],
      "type": "string"
    },
    "root_cause": {
      "additionalProperties": false,
      "properties": {
        "observed": {
          "enum": [
            "anchored",
            "hypothesis",
            "none"
          ],
          "type": "string"
        }
      },
      "required": [
        "observed"
      ],
      "type": "object"
    },
    "v": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "v",
    "kind",
    "root_cause"
  ],
  "type": "object"
}
